{
	"i18n": true,
	"type": "panel",
	"items": {
		"accountName": {
			"type": "text",
			"label": "Account name (optional)",
			"default": "",
			"maxLength": 100,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"schoolSearch": {
			"type": "text",
			"label": "Search schools by name, town, or ID",
			"help": "Enter at least two characters, then choose a matching school below.",
			"default": "",
			"maxLength": 100,
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"schoolId": {
			"type": "selectSendTo",
			"label": "Select a matching school",
			"command": "searchSchools",
			"jsonData": "{\"query\":\"${data.schoolSearch}\"}",
			"alsoDependsOn": ["schoolSearch"],
			"noTranslation": true,
			"manual": false,
			"default": "",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"credentialId": {
			"type": "credential",
			"label": "Custom login/password credential",
			"default": "",
			"credentialType": "custom",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"refreshIntervalMinutes": {
			"type": "number",
			"label": "Refresh interval",
			"default": 60,
			"min": 5,
			"max": 1440,
			"step": 1,
			"unit": "min",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		}
	}
}